'Writes the logo BMP to the given folder (once) and returns its path.
Public Function LogoFile(ByVal folder As String) As String
    Dim h As String, b() As Byte, i As Long, n As Long, f As Integer, p As String
    p = folder & "\vdot_logo.bmp"
    If Len(Dir$(p)) = 0 Then
        h = LogoHex()
        n = Len(h) \ 2
        ReDim b(0 To n - 1)
        For i = 0 To n - 1
            b(i) = CByte("&H" & Mid$(h, i * 2 + 1, 2))
        Next
        f = FreeFile
        Open p For Binary Access Write As #f
        Put #f, 1, b
        Close #f
    End If
    LogoFile = p
End Function